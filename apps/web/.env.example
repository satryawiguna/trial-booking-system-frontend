# =============================================================================
# Trial Booking System — Parent View (apps/web) — Environment Variables
# =============================================================================
# Copy this file to .env.local and adjust values for your local environment.
# .env.local is git-ignored and should NEVER be committed.

# Base URL of the backend REST API (see architecture/api-design.md — Base URL: /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Base URL of the Admin View app (apps/admin), used by the Navbar's role
# switch for cross-app navigation (see design/navigation.md — App Shell).
# apps/admin runs on port 3001 by default (see apps/admin/package.json).
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
