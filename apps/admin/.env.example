# =============================================================================
# Trial Booking System — Admin View (apps/admin) — Environment Variables
# =============================================================================
# Copy this file to .env.local and adjust values for your local environment.
# .env.local is git-ignored and should NEVER be committed.

# Base URL of the backend REST API (see architecture/api-design.md — Base URL: /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Base URL of the Parent View app (apps/web), used by the Navbar's role
# switch for cross-app navigation (see design/navigation.md — App Shell).
# apps/web runs on port 3000 by default (see apps/web/package.json).
NEXT_PUBLIC_WEB_URL=http://localhost:3000
