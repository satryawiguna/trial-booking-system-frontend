# =============================================================================
# Trial Booking System — Frontend — Environment Variables
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# .env is git-ignored and should NEVER be committed.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Environment: development | production
NODE_ENV=development

# -----------------------------------------------------------------------------
# Backend API
# -----------------------------------------------------------------------------
# Base URL of the trial-booking-system-backend API
# Local:   http://localhost:3000/api/v1
# Docker:  http://host.docker.internal:3000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# -----------------------------------------------------------------------------
# Frontend URLs (used for cross-app navigation)
# -----------------------------------------------------------------------------
# Admin View URL (used by Parent View's role switcher)
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Parent View URL (used by Admin View's role switcher)
NEXT_PUBLIC_WEB_URL=http://localhost:3002
